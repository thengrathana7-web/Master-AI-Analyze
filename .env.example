# Deriv Real-Time API Configuration
# Default public app_id for market data: 1089
DERIV_APP_ID="1089"
DERIV_ACTIVE_SYMBOL="stpRNG"

# Telegram Bot Integration (Required for 24/7 background trade alerts)
# Create a bot with @BotFather to receive your token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Get your User / Group / Channel ID from @userinfobot
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Server & Hosting Configuration
PORT=3000
APP_URL="https://your-domain.netlify.app"
